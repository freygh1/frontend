---
import { getCollection, type CollectionEntry } from "astro:content";

const lessons: CollectionEntry<"lessons">[] = await getCollection("lessons");

// course → category → lessons
const grouped = new Map<string, Map<string, typeof lessons>>();
for (const lesson of lessons) {
  const { course, category } = lesson.data;
  if (!grouped.has(course)) grouped.set(course, new Map());
  const categories = grouped.get(course)!;
  if (!categories.has(category)) categories.set(category, []);
  categories.get(category)!.push(lesson);
}
---

<section id="toc" class="space-y-8">
  {
    [...grouped.entries()].map(([course, categories]) => {
      const total = [...categories.values()].reduce(
        (acc, arr) => acc + arr.length,
        0,
      );
      return (
        <article class="bg-white rounded-2xl border border-slate-200 p-6">
          <header class="flex items-baseline justify-between mb-4 pb-4 border-b border-slate-100">
            <h2 class="text-2xl font-bold">{course}</h2>
            <span class="text-sm text-slate-500">{total} lecciones</span>
          </header>

          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {[...categories.entries()].map(([category, categoryLessons]) => (
              <div>
                <button
                  type="button"
                  data-toc-filter
                  data-course={course}
                  data-category={category}
                  class="text-sm font-semibold text-slate-700 uppercase tracking-wide mb-2 hover:text-amber-700 transition-colors"
                >
                  {category} →
                </button>
                <ul class="space-y-1">
                  {/* Se anota el tipo 'CollectionEntry<'lessons'>' en el parámetro 'lesson' */}
                  {categoryLessons.map((lesson: CollectionEntry<"lessons">) => (
                    <li>
                      <a
                        href={`/lessons/${lesson.id}`}
                        class="text-sm text-slate-600 hover:text-amber-700 hover:underline block truncate"
                      >
                        {lesson.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </article>
      );
    })
  }
</section>
