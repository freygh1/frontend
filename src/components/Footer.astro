---
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-slate-200 bg-white/60">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <!-- Marca -->
      <a
        href="/"
        class="text-sm font-semibold text-slate-900 hover:text-amber-700 transition-colors"
      >
        The Sun Learning
      </a>

      <!-- Crédito -->
      <p class="text-sm text-slate-600 text-center sm:text-right">
        Made with
        <span class="text-amber-500" aria-label="love"> &hearts; </span>
        by Freilyns &lsquo;<span class="italic">Frey</span> &rsquo; Granville
      </p>
    </div>

    <!-- Línea inferior -->
    <div
      class="mt-6 pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-slate-400"
    >
      <span>&copy; {year} The Sun Learning</span>
      <span>Fase de pruebas - contenido en desarrollo</span>
    </div>
  </div>
</footer>
