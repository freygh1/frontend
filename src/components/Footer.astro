---
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-slate-200 bg-white/60">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8 sm:py-10">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <span class="text-xs text-slate-400">&copy; {year} The Sun Learning</span>
      <p class="text-sm text-slate-600 text-center sm:text-right">
        Made with
        <span class="text-amber-500" aria-label="love"> &hearts; </span>
        by Freilyns &lsquo;<span class="italic">Frey</span> &rsquo; Granville
      </p>
    </div>
  </div>
</footer>
