---
import { getCollection, type CollectionEntry } from "astro:content";

const lessons: CollectionEntry<"lessons">[] = await getCollection("lessons");

const courses = [...new Set(lessons.map((l) => l.data.course))].sort();

const categories = [...new Set(lessons.map((l) => l.data.category))].sort();

const CEFR_ORDER = ["A1", "A2", "B1", "B2", "C1", "C2"];
const levels = [...new Set(lessons.map((l) => l.data.level))].sort(
  (a, b) => CEFR_ORDER.indexOf(a) - CEFR_ORDER.indexOf(b),
);
---

<section id="search" class="scroll-mt-4">
  <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5">
    <div class="relative">
      <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"
        >🔍</span
      >
      <input
        id="search-input"
        type="search"
        placeholder="Busca por título, tema o etiqueta…"
        aria-label="Buscar lecciones"
        class="w-full rounded-lg border border-slate-200 pl-11 pr-10 py-3 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-transparent"
      />
      <button
        id="search-clear"
        type="button"
        aria-label="Limpiar búsqueda"
        class="hidden absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-700"
        >✕</button
      >
    </div>

    <div class="mt-4 flex flex-wrap gap-2">
      <select id="filter-course" class="filter-chip">
        <option value="">Todos los cursos</option>
        {courses.map((course) => <option value={course}>{course}</option>)}
      </select>

      <select id="filter-category" class="filter-chip">
        <option value="">Todas las categorías</option>
        {
          categories.map((category) => (
            <option value={category}>{category}</option>
          ))
        }
      </select>

      <select id="filter-level" class="filter-chip">
        <option value="">Todos los niveles</option>
        {levels.map((level) => <option value={level}>{level}</option>)}
      </select>

      <button
        id="filter-clear"
        type="button"
        class="hidden ml-auto text-sm text-slate-500 hover:text-slate-800 underline"
        >Limpiar todo</button
      >
    </div>

    <p class="mt-4 text-sm text-slate-500">
      <strong id="results-count" class="text-slate-800">0</strong>
      <span id="results-label">lecciones</span>
    </p>
  </div>
</section>
